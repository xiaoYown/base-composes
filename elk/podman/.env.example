# ELK 日志栈环境变量 —— 账号/端口/保留期 (USER/PASSWORD 仅数据卷首次初始化生效)
# 采集目录 LOGS_DIR 须位于 /Users 或 /var/folders 下 (podman machine 挂载约束)

# ---- clickhouse 26.3 ----
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD="clickhouse123456"
CLICKHOUSE_HTTP_PORT=8123         # HTTP 查询面 (自研 UI/脚本对接)
CLICKHOUSE_NATIVE_PORT=9000       # native, 宿主 clickhouse-client 直连
LOG_TTL_DAYS=30                   # 日志保留天数 (建表时生效, 改后需 ALTER)

# ---- fluent-bit 三入口 ----
FB_HTTP_PORT=8686                 # 应用直推 (每行一个 JSON 对象)
OTLP_HTTP_PORT=4318               # OTLP/HTTP (OTel SDK: OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318)
FB_HOST=fluent-bit                # 写库 host 字段标识
LOGS_DIR=/Users/xiaoyown/elk-logs # 文件采集目录 (*.log 含一级子目录; 换成应用日志目录即可)

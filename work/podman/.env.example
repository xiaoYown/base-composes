# work 中间件分组环境变量 —— 每服务一段完整连接块 (host 视角)
# 应用侧取值: 宿主进程按 HOST 原样连; 其他 compose 分组的容器把 HOST 换成 host.containers.internal
# USER/DATABASE 仅数据卷首次初始化生效, 改动对既有卷无效 (库内账号权限需 SQL 改)

# ---- mysql:8 (root 免密; 业务账号由 USER/PASSWORD/DATABASE 建) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rpuser
MYSQL_PASSWORD=<看旧容器元数据或团队密码表>
MYSQL_DATABASE=db_knowanchor

# ---- postgres (pgvector/pg16) ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=rwuser
POSTGRES_PASSWORD=<看旧容器元数据或团队密码表>
POSTGRES_DB=db_agent_knowanchor

# ---- redis:8 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- rocketmq 5.3.2 (light-kb) ----
# 应用侧连接串: MQ_ENDPOINT=127.0.0.1:8081 (容器间用 host.containers.internal:8081)
ROCKETMQ_PROXY_PORT=8081        # 客户端入口 (gRPC), 即 MQ_ENDPOINT 的端口
ROCKETMQ_NAMESRV_PORT=9876      # nameserver, mqadmin/运维排查用
MQ_TOPICS=heavy-job-task heavy-job-result   # 预建 topic 清单 (空格分隔; rocketmq-topics 一次性建)
ROCKETMQ_NAMESRV_HEAP=-Xms256m -Xmx256m -Xmn128m
ROCKETMQ_BROKER_HEAP=-Xms512m -Xmx512m -Xmn128m
ROCKETMQ_PROXY_HEAP=-Xms512m -Xmx512m -Xmn128m
